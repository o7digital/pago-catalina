# Isolated Catalina API route. Included by the existing Mailcow HTTPS vhost.
# This uses only Catalina's dedicated private listener; no mail routes are replaced.
location ^~ /catalina-backend/api/ {
    if ($scheme != https) { return 403; }
    client_max_body_size 1m;
    rewrite ^/catalina-backend(/api/.*)$ $1 break;
    proxy_pass http://172.22.1.1:8120;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
    proxy_redirect off;
    proxy_cookie_path /api/admin /api/admin;
    add_header Cache-Control "no-store" always;
}
