NODE_ENV=production
HOST=127.0.0.1
PORT=8120
# Set to the private reverse proxy subnet only when using a containerized proxy.
TRUSTED_PROXY=loopback
PUBLIC_ORIGIN=https://pago-catalina.vercel.app
DATABASE_PATH=/var/lib/pago-catalina/catalina.sqlite
# Generate once with: openssl rand -hex 32. Remove after activation.
ADMIN_SETUP_TOKEN=
# Set both from the SAME Stripe account and environment. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
